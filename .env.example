# Supabase Configuration (Required)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App Environment (Required)
EXPO_PUBLIC_APP_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# AI Onboarding (Wire AI) — OPTIONAL, but ON by default when a key is present.
# Leave these unset and onboarding renders the built-in static questionnaire
# (zero setup). Set the key + server URL to upgrade the SAME screen to AI-driven
# dynamic onboarding — the static flow stays as an automatic fallback.
# Grab a free key at https://getwireai.com
# ─────────────────────────────────────────────────────────────────────────────
# EXPO_PUBLIC_WIREAI_API_KEY=your-wire-ai-tenant-key
# EXPO_PUBLIC_WIREAI_SERVER_URL=https://your-wire-ai-server.com
# EXPO_PUBLIC_WIREAI_APP_ID=your-app-id

# ─────────────────────────────────────────────────────────────────────────────
# Payments (RevenueCat) — OPTIONAL. Without a key the paywall degrades gracefully
# (RevenueCat init is skipped). Use PRODUCTION keys (goog_/appl_) for release
# builds — a test_ key in a release build is rejected on purpose (it would crash
# the native SDK). The entitlement id defaults to "premium"; override to match
# the entitlement configured in your RevenueCat dashboard.
# ─────────────────────────────────────────────────────────────────────────────
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_ios_key
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_android_key
# EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Analytics + Crashlytics — analytics/crash reporting are wired in code,
# but the NATIVE builds need buyer-supplied Firebase config files (NOT env vars,
# and never committed to a public repo):
#   • android/app/google-services.json          (from the Firebase console)
#   • ios/GoogleService-Info.plist               (from the Firebase console)
# The Expo config plugins are already declared in app.json (@react-native-firebase/app,
# @react-native-firebase/crashlytics, expo-build-properties). Add the files, then
# run a native prebuild/EAS build. In Expo Go / __DEV__, analytics is gated off and
# a silent mock is used, so no config is needed just to run the app.
# ─────────────────────────────────────────────────────────────────────────────

# Optional: Add other environment variables as needed
# EXPO_PUBLIC_FCM_SENDER_ID=your-fcm-sender-id
# EXPO_PUBLIC_DD_APPLICATION_ID=your-datadog-app-id
# EXPO_PUBLIC_DD_CLIENT_TOKEN=your-datadog-client-token
# EXPO_PUBLIC_DD_ENV=development
# EXPO_PUBLIC_BASE_URL=https://your-api-url.com
# EXPO_PUBLIC_APP_TOKEN=your-app-token
# EXPO_PUBLIC_CONFIGCAT_SDK_KEY_BACKEND=your-configcat-backend-key
# EXPO_PUBLIC_CONFIGCAT_SDK_KEY_FRONTEND=your-configcat-frontend-key
